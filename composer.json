{
    "name": "componenta/auth-session-csrf",
    "description": "Authentication-session-bound CSRF tokens for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/auth-session": "dev-main",
        "componenta/http-csrf-middleware": "dev-main",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Csrf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Csrf\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/componenta/auth.git"},
        {"type": "vcs", "url": "https://github.com/componenta/auth-session.git"},
        {"type": "vcs", "url": "https://github.com/componenta/http-csrf-middleware.git"}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {"branch-alias": {"dev-main": "1.0.x-dev"}},
    "config": {"sort-packages": true},
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": ["@phpstan", "@test"]
    }
}
